# Postgres connection (Neon in production). Required.
DATABASE_URL=postgres://postgres@localhost:5433/toon_dev
# Comma-separated emails that become admins when they sign up.
ADMIN_EMAILS=
# Vercel Blob read-write token. Required in production for uploads. Without it, uploads go to .data/media (dev only).
BLOB_READ_WRITE_TOKEN=
# Email (password reset, new-release notices). Without these, production records emails but does not send them.
RESEND_API_KEY=
EMAIL_FROM="Tune Comics & Studio <hello@example.com>"
# Base URL for links in emails, e.g. https://tune.example.com
APP_URL=
# Secret Vercel Cron sends to /api/cron/email.
CRON_SECRET=
